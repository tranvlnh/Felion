DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DATABASE_URL=postgres://felion:change-me@localhost:5432/felion
NODE_ENV=development

# Web admin. In dev with `npm run dev:frontend`, use http://localhost:5173 so Google returns through the Vite proxy.
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Google Cloud OAuth client (type "Web application", consent screen "Internal").
# Authorized redirect URI: <WEB_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
